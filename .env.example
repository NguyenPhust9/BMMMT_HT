# SecurePay Lab — Example Environment Configuration (.env.example)
# Copy to .env for local execution. Never commit real secrets.

DJANGO_SECRET_KEY=replace-with-local-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://127.0.0.1:8443,https://localhost:8443
SECUREPAY_HTTPS_PROFILE=False

# PostgreSQL Database Connection (127.0.0.1 only)
POSTGRES_DB=securepay_lab
POSTGRES_USER=securepay_user
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Security Policy Parameters (Section 3.1 Baseline)
CHALLENGE_TTL_SECONDS=120
REQUEST_TTL_HOURS=24
PREAUTH_TTL_SECONDS=300
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=28800
MAX_PASSWORD_ATTEMPTS=5
PASSWORD_COOLDOWN_SECONDS=300
MAX_OTP_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=300

